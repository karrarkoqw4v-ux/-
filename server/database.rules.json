{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['name', 'username'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 35"
        },
        "username": {
          ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9_.]{3,20}$/)"
        },
        "avatar": {
          ".validate": "newData.isString()"
        },
        "$other": { ".validate": false }
      }
    },

    "usernames": {
      "$username": {
        ".read": true,
        ".write": "auth != null && (!data.exists() || data.val() === auth.uid)",
        ".validate": "newData.isString() && newData.val() === auth.uid"
      }
    },

    "userConversations": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "$convId": {
          ".validate": "newData.isBoolean()"
        }
      }
    },

    "conversations": {
      "$convId": {
        ".read": "auth != null && root.child('conversations').child($convId).child('participants').child(auth.uid).exists()",

        "participants": {
          ".read": "auth != null && data.child(auth.uid).exists()",
          ".write": "auth != null && (!data.exists() || data.child(auth.uid).exists())",
          "$uid": { ".validate": "newData.isBoolean()" }
        },

        "meta": {
          ".write": "auth != null && root.child('conversations').child($convId).child('participants').child(auth.uid).exists()",
          "lastMessage": { ".validate": "newData.isString() && newData.val().length <= 4000" },
          "lastAt": { ".validate": "newData.isString()" }
        },

        "messages": {
          "$msgId": {
            ".write": "auth != null && root.child('conversations').child($convId).child('participants').child(auth.uid).exists() && !data.exists() && newData.child('senderId').val() === auth.uid",
            ".validate": "newData.hasChildren(['id', 'senderId', 'text', 'at'])",
            "id": { ".validate": "newData.isString()" },
            "senderId": { ".validate": "newData.isString()" },
            "text": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 4000" },
            "at": { ".validate": "newData.isString()" },
            "$other": { ".validate": false }
          }
        }
      }
    }
  }
}
